# Copy this file to .env and fill in your API keys.
#
# Three model roles are used. Each takes an OpenAI-compatible endpoint
# (OpenRouter, Google AI Studio, or any compatible provider).

# --- Planner (used by --plan and for structured JSON answers) ---
ORCHESTRATOR_BASE_URL=https://openrouter.ai/api/v1
ORCHESTRATOR_API_KEY=
ORCHESTRATOR_MODEL=google/gemini-2.5-pro

# --- Image generation (paints the map and the walkable-area overlays) ---
# IMAGE_GEN_PROVIDER: openai-compatible (OpenRouter etc.) or google-native (Google AI Studio)
IMAGE_GEN_PROVIDER=openai-compatible
IMAGE_GEN_BASE_URL=https://openrouter.ai/api/v1
IMAGE_GEN_API_KEY=
IMAGE_GEN_MODEL=google/gemini-3.1-flash-image

# --- Vision review (checks each generated image and locates areas) ---
VISION_BASE_URL=https://openrouter.ai/api/v1
VISION_API_KEY=
VISION_MODEL=google/gemini-3.1-pro-preview

# Google AI Studio instead of OpenRouter:
# ORCHESTRATOR_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# ORCHESTRATOR_MODEL=gemini-2.5-pro
# IMAGE_GEN_PROVIDER=google-native
# IMAGE_GEN_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# IMAGE_GEN_MODEL=gemini-3.1-flash-image
# VISION_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# VISION_MODEL=gemini-3.1-pro-preview
# (use your AIza... key for all three *_API_KEY values)

# --- Map size and grid (LPC defaults) ---
# MAP_IMAGE_SIZE_K: 1 = 1024px image, 2 = 2048px, 4 = 4096px.
# BLOCK_SIZE: pixels per grid cell. 32 matches LPC tiles, so a 1K map is a
# 32x32-tile map at native LPC scale (2K -> 64x64 tiles).
MAP_IMAGE_SIZE_K=1
BLOCK_SIZE=32

# --- Art style, applied to every map ---
ART_STYLE_PROMPT=LPC (Liberated Pixel Cup) style top-down pixel art for a 32x32-tile RPG, soft natural palette, clean dark outlines, no text or labels

# Optional: where runs are written (default: ./output/maps)
# MAP_OUTPUT_DIR=
